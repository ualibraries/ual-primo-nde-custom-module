# Copy to .env (gitignored) for local integration test settings.

# Primo view to test (default: 01UA_INST:ndeDev)
# NDE_VID=01UA_INST:ndeDev

# Sandbox test patron for the My Account tests (e2e/account/).
# Must be an Alma internal/local account. NetID + Duo logins can't be automated.
# Leave blank to skip the My Account tests.
NDE_PATRON_USER=
NDE_PATRON_PASSWORD=
